# --- Model: open-weights on YOUR machine (patient data never leaves it) ---
TRIAGE_PROVIDER=ollama
TRIAGE_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional comparison on SYNTHETIC patients only (blocked for real patients by the residency guard)
# TRIAGE_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

TRIAGE_DB=triage.db

# --- Gmail (OAuth2, see README) ---
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
ALERT_EMAIL_TO=
TRIAGE_ALERT_EMAILS=1
# Fallback only if you do not use OAuth: Gmail app password
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
